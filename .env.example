# KernelSentinel Configuration
PORT=8000
HOST=127.0.0.1

# AI Model Provider Credentials (Optional: Local Test Mode used if unprovided)
GEMINI_API_KEY=
OPENAI_API_KEY=
MODEL_PROVIDER=local_test # Options: gemini, openai, local_test

# Database path
DATABASE_PATH=medical-agent/kernelsentinel.db

# Behavioral Engine settings
RISK_THRESHOLD_SUSPICIOUS=30.0
RISK_THRESHOLD_HIGH=60.0
RISK_THRESHOLD_CRITICAL=80.0

# Monitoring IPC settings
COLLECTOR_IPC_PORT=9090
